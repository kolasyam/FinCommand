{
  "name": "fincommand-pro",
  "version": "1.0.0",
  "private": true,
  "description": "FinCommand Pro — CFO/CEO Financial Dashboard (unified Next.js app)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx db/init.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/init.ts --reset && tsx db/seed.ts",
    "db:migrate:branch": "tsx db/migrate.ts --target=branch",
    "db:migrate:main": "tsx db/migrate.ts --target=main",
    "db:migrate:status": "tsx db/migrate.ts --target=main --status",
    "db:migrate:status:branch": "tsx db/migrate.ts --target=branch --status",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^3.8.4",
    "next": "^16.3.6",
    "pg": "^8.13.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "dompurify": "^3.4.15",
    "uuid": "^14.0.2"
  }
}
