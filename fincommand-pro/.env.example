# ─────────────────────────────────────────────
#  FinCommand Pro — Environment Variables
#  Copy this file to .env.local (or .env) and fill in real values.
#  Every name below matches the original backend/.env exactly — no renames.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (Neon or any Postgres). DB_* is the source of truth.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fincommand
DB_USER=fincommand_user
DB_PASSWORD=MyStrongPassword123!
DATABASE_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# How long an unused pooled connection stays open (ms). Default 300000 (5 min):
# opening a connection costs ~5 round trips, so keeping them avoids a slow first
# click after a short pause. Lower it only if the database limits connections.
# DB_IDLE_TIMEOUT_MS=300000
# Keeps the Neon compute awake between requests (owner's decision, 2026-09-20;
# it costs compute hours, because the database now never suspends). A long-lived
# server pings the database every DB_KEEPALIVE_MS (default 240000 = 4 min, under
# Neon's 5-minute suspend). On Vercel a cron does it instead
# (/api/v1/internal/keepalive in vercel.json, guarded by CRON_SECRET).
# Set 0 to let Neon suspend when idle.
# DB_KEEPALIVE_MS=240000
# How long a user's record is remembered between requests (ms), default 30000.
# A user deactivated or given another role on a DIFFERENT server instance keeps
# the old access for up to this long. 0 turns it off; always off in development.
# AUTH_CACHE_TTL_MS=30000

# Row-level security (migration 0008; docs/ROW-LEVEL-SECURITY.md). When BOTH are set, every
# company-scoped request logs in to the database as this restricted role and the DATABASE
# ITSELF refuses another company's rows. Leave them unset and the app uses the DB_USER login
# above exactly as before (nothing is enforced by the database). Set them in PRODUCTION
# (Vercel); local development is faster without them (each query costs ~2 extra round trips).
# The password: `npx tsx db/scripts/set-app-role-password.ts --target=main --generate`
# puts a new one on your clipboard without printing it. Unset both to switch enforcement off.
# DB_APP_USER=fincommand_app
# DB_APP_PASSWORD=

# Optional: a full connection string (e.g. Neon's pooled URL) can be supplied
# instead of individual DB_* host/port/etc, but DB_* remains the fallback and
# nothing requires this to be set.
# DATABASE_URL=

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_different_from_above
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Zoho Books OAuth
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:4000/api/v1/zoho/callback
ZOHO_SCOPES=ZohoBooks.fullaccess.all
ZOHO_DATA_CENTER=IN

# Protects the internal cron endpoints (app/api/v1/internal/zoho-cron and
# /keepalive) —
# REQUIRED in production: without it the routes refuse to run (503). In
# development it may be left unset. Set a long random value here and
# configure whatever calls this endpoint (Vercel Cron sends it automatically,
# or an external scheduler per ZOHO_SYNC_CRON below) to send it as
# `Authorization: Bearer <value>`.
# CRON_SECRET=

# Encrypts Zoho Books access/refresh tokens at rest (lib/security/token-crypto.ts).
# REQUIRED: without it Zoho can't be connected or synced. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value everywhere that reads the same database (local + Vercel),
# and never change it without re-encrypting the stored tokens.
# TOKEN_ENCRYPTION_KEY=

# Optional, local only: a Neon test branch used to try migrations before main
# (npm run db:migrate:branch — never `npm run … -- --target=…` in PowerShell,
# which drops the flags). Never used by the running app.
# BRANCH_DATABASE_URL=

# File Upload — local-development only. TB uploads are parsed in-memory in
# production (no disk writes), so this has no effect on Vercel.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS reference / email links)
FRONTEND_URL=http://localhost:3000

# Logging — local-development only.
LOG_LEVEL=info
LOG_DIR=./logs

# Cron — Zoho auto-sync (used to configure the Vercel Cron schedule / an
# external scheduler hitting /api/v1/internal/zoho-cron)
ZOHO_SYNC_CRON=0 */15 * * * *
