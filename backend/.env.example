# ─────────────────────────────────────────────
#  FinCommand Pro — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fincommand
DB_USER=fincommand_user
DB_PASSWORD=MyStrongPassword123!
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_different_from_above
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Zoho Books OAuth
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:4000/api/v1/zoho/callback
ZOHO_SCOPES=ZohoBooks.fullaccess.all
ZOHO_DATA_CENTER=IN

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Cron — Zoho auto-sync
ZOHO_SYNC_CRON=0 */15 * * * *
